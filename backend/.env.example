# Unforgotten India — Backend Environment Variables Example
#
# Copy this file to .env for backend configuration.
# NEVER commit .env to version control.

# Application metadata
PROJECT_NAME="Unforgotten India API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS origins (JSON array or comma-separated list)
# Default includes local dev ports and Docker host
# CORS_ORIGINS='["http://localhost", "http://localhost:80", "http://localhost:5173", "http://localhost:5175", "http://127.0.0.1:5173"]'

# Server Host and Port (used by Uvicorn)
HOST="0.0.0.0"
PORT=8000
