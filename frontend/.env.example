# Unforgotten India — Frontend Environment Variables Example
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.

# Backend API base URL
# Local development default: http://localhost:8000/api/v1
# Docker container default: /api/v1 (proxied via Nginx)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: Google Gemini API Key for Ask the Story AI Assistant
# If omitted, the application uses a grounded deterministic demonstration fallback.
# Note: VITE_* variables are included in the frontend client bundle.
# Get a key at: https://aistudio.google.com/app/apikey
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
